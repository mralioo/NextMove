# NextMove — environment template.  Copy to `.env` (never commit `.env`) and fill in the values:
#     cp .env.example .env
# `.env` is found by walking up from the working directory (env_loader.py). Lines starting with # are comments.
# Only the REQUIRED block is needed to answer questions; everything else has a working default.

# ============================================================================================
# REQUIRED
# ============================================================================================

# TabPFN (tabular foundation model) — forecasts for closures, pressure ranking and station predictions.
# Get a token at https://ux.priorlabs.ai . Not needed if you run with SCENARIO_ENGINE=empirical (no ML).
TABPFN_API_TOKEN=

# --- LLM per role (via LiteLLM). SUPERVISOR_* is the strong model: Dispatcher fallback, Inspector and Writer.
# Azure OpenAI example (the host containing "azure.com" gets the `azure/` prefix and api-version automatically):
SUPERVISOR_LITELLM_MODEL=azure/<your-deployment-name>
SUPERVISOR_API_BASE=https://<your-resource>.openai.azure.com/
SUPERVISOR_API_KEY=
# SUPERVISOR_API_VERSION=2025-01-01-preview     # optional; taken from the api-base URL query string if omitted

# WORKER_* is the small, cheap model: router fallback and small tasks.  (OpenAI example; any LiteLLM model name works)
WORKER_LITELLM_MODEL=gpt-4o-mini
WORKER_API_KEY=
# WORKER_API_BASE=

# Some setups read the plain OpenAI key directly (LiteLLM default for `gpt-*` names):
OPENAI_API_KEY=

# ============================================================================================
# OPTIONAL — per-role model overrides (each falls back: ROLE → SUPERVISOR/WORKER → ADK)
# ============================================================================================
# WRITER_LITELLM_MODEL=            # the brief writer (defaults to the SUPERVISOR model)
# WRITER_API_BASE=
# WRITER_API_KEY=
# WRITER_REASONING_EFFORT=low      # for reasoning models (gpt-5*): low | medium | high
# WRITER_TIMEOUT_S=
# EVALUATOR_LITELLM_MODEL=         # the Inspector's LLM check (defaults to the SUPERVISOR model)
# ROUTER_LITELLM_MODEL=            # router fallback (defaults to the WORKER model)

# ============================================================================================
# OPTIONAL — memory agent (Cognee). OFF by default: nothing leaves the machine unless enabled.
# ============================================================================================
COGNEE_ENABLED=0                   # 1 = mirror knowledge base + feedback to Cognee (sends data to your Cognee tenant)
# COGNEE_API_BASE_URL=https://<your-tenant>.cognee.ai
# COGNEE_API_KEY=
# COGNEE_DATASET=

# ============================================================================================
# OPTIONAL — knowledge graph in Neo4j (`make up` starts a local Docker container; dev-only password)
# ============================================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# NEO4J_MIRROR=off                 # off = keep the graph only in SQLite (used by the unit tests)

# ============================================================================================
# OPTIONAL — LangSmith-style evaluation upload (only with `--upload` / a key)
# ============================================================================================
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LS_JUDGE_MODEL=

# ============================================================================================
# OPTIONAL — behaviour and ports (defaults shown)
# ============================================================================================
# TMT_ANSWER_MODE=brief            # brief | detail
# TMT_HISTORY=on                   # off = do not reuse history / do not train the graph (evaluation runs)
# TMT_CONFIG={"router":"rules","memory":"session","mcp":"stdio","engine":"tabpfn","writer":"llm"}
# SCENARIO_ENGINE=tabpfn           # tabpfn | empirical (no TabPFN token needed)
# QUALITY_MCP=on                   # off = Inspector skips the quality database
# WARM_ON_START=1                  # 0 = do not warm the MCP server at agent start
# LOOP_MAX_ITERS=2
# LOOP_DEADLINE_S=40
# GUARD_MAX_QUESTION_CHARS=1500
# GUARD_MAX_ANSWER_WORDS=230
# GUARD_MIN_CONFIDENCE=0.35
# OPERATOR_API_HOST=127.0.0.1
# OPERATOR_API_PORT=8770
# OPERATOR_API_CORS=*              # restrict for anything but a local demo
# ADK_PORT=8000
# PORT=8501                        # Streamlit dashboard
# MCP_KNOWLEDGE_PORT=8766
# MCP_QUALITY_PORT=8768
# MCP_DATA_PORT=8765
