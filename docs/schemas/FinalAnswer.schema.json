{
 "$defs": {
  "GuardrailResult": {
   "additionalProperties": false,
   "description": "One guardrail check. `action` is what the system did about a failure: allow | bounce (unrelated question, conversation cut) |\ncut (stop the loop) | repair (fix the output deterministically) | fallback (safe deterministic answer) | escalate (flag low confidence).",
   "properties": {
    "stage": {
     "enum": [
      "input",
      "route",
      "worker",
      "evaluator",
      "output",
      "failsafe"
     ],
     "title": "Stage",
     "type": "string"
    },
    "check": {
     "title": "Check",
     "type": "string"
    },
    "passed": {
     "title": "Passed",
     "type": "boolean"
    },
    "action": {
     "default": "allow",
     "enum": [
      "allow",
      "bounce",
      "cut",
      "repair",
      "fallback",
      "escalate"
     ],
     "title": "Action",
     "type": "string"
    },
    "detail": {
     "default": "",
     "title": "Detail",
     "type": "string"
    }
   },
   "required": [
    "stage",
    "check",
    "passed"
   ],
   "title": "GuardrailResult",
   "type": "object"
  },
  "Reference": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "dataset",
      "tool",
      "kb",
      "kg",
      "model"
     ],
     "title": "Kind",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "note": {
     "default": "",
     "title": "Note",
     "type": "string"
    }
   },
   "required": [
    "kind",
    "id"
   ],
   "title": "Reference",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "schema_version": {
   "default": "1.0",
   "title": "Schema Version",
   "type": "string"
  },
  "plan_id": {
   "title": "Plan Id",
   "type": "string"
  },
  "text": {
   "title": "Text",
   "type": "string"
  },
  "decision": {
   "enum": [
    "proceed",
    "answer_from_history",
    "follow_up",
    "decline",
    "need_input",
    "bounce"
   ],
   "title": "Decision",
   "type": "string"
  },
  "category": {
   "enum": [
    "A",
    "B",
    "C",
    "D",
    "E",
    "F",
    "G",
    "H",
    "P",
    "X",
    "OOS",
    "FOLLOW",
    "BOUNCE"
   ],
   "title": "Category",
   "type": "string"
  },
  "confidence": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Confidence"
  },
  "verdict": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Verdict"
  },
  "references": {
   "default": [],
   "items": {
    "$ref": "#/$defs/Reference"
   },
   "title": "References",
   "type": "array"
  },
  "guardrails": {
   "default": [],
   "items": {
    "$ref": "#/$defs/GuardrailResult"
   },
   "title": "Guardrails",
   "type": "array"
  },
  "iterations": {
   "default": 0,
   "title": "Iterations",
   "type": "integer"
  },
  "seconds": {
   "default": 0.0,
   "title": "Seconds",
   "type": "number"
  },
  "source": {
   "default": "worker",
   "enum": [
    "worker",
    "history",
    "bounce",
    "decline",
    "safe_fallback",
    "follow_up"
   ],
   "title": "Source",
   "type": "string"
  }
 },
 "required": [
  "plan_id",
  "text",
  "decision",
  "category"
 ],
 "title": "FinalAnswer",
 "type": "object"
}