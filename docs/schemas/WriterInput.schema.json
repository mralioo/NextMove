{
 "$defs": {
  "Adjustments": {
   "additionalProperties": false,
   "description": "What the evaluator may ask the worker to change on the next iteration (a closed list: nothing else can be overridden).",
   "properties": {
    "dates": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Dates"
    },
    "times": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Times"
    },
    "stations": {
     "anyOf": [
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Stations"
    },
    "top_n": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Top N"
    },
    "rain": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rain"
    },
    "duration_min": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Duration Min"
    },
    "ml_engine": {
     "anyOf": [
      {
       "enum": [
        "tabpfn",
        "empirical",
        "none"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Ml Engine"
    }
   },
   "title": "Adjustments",
   "type": "object"
  },
  "CheckResult": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "ok": {
     "title": "Ok",
     "type": "boolean"
    },
    "detail": {
     "default": "",
     "title": "Detail",
     "type": "string"
    }
   },
   "required": [
    "id",
    "ok"
   ],
   "title": "CheckResult",
   "type": "object"
  },
  "EvaluatorVerdict": {
   "additionalProperties": false,
   "properties": {
    "schema_version": {
     "default": "1.0",
     "title": "Schema Version",
     "type": "string"
    },
    "task_id": {
     "title": "Task Id",
     "type": "string"
    },
    "iteration": {
     "title": "Iteration",
     "type": "integer"
    },
    "verdict": {
     "enum": [
      "accept",
      "revise",
      "reject"
     ],
     "title": "Verdict",
     "type": "string"
    },
    "objective_met": {
     "title": "Objective Met",
     "type": "boolean"
    },
    "score": {
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Score",
     "type": "number"
    },
    "issues": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Issues",
     "type": "array"
    },
    "adjustments": {
     "anyOf": [
      {
       "$ref": "#/$defs/Adjustments"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "checks": {
     "default": [],
     "items": {
      "$ref": "#/$defs/CheckResult"
     },
     "title": "Checks",
     "type": "array"
    },
    "ground_truth_ids": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Ground Truth Ids",
     "type": "array"
    },
    "boundary_ids": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Boundary Ids",
     "type": "array"
    },
    "similar_cases": {
     "default": [],
     "items": {
      "$ref": "#/$defs/KGCase"
     },
     "title": "Similar Cases",
     "type": "array"
    },
    "rationale": {
     "default": "",
     "title": "Rationale",
     "type": "string"
    },
    "model": {
     "default": "deterministic",
     "title": "Model",
     "type": "string"
    },
    "seconds": {
     "default": 0.0,
     "title": "Seconds",
     "type": "number"
    }
   },
   "required": [
    "task_id",
    "iteration",
    "verdict",
    "objective_met",
    "score"
   ],
   "title": "EvaluatorVerdict",
   "type": "object"
  },
  "KGCase": {
   "additionalProperties": false,
   "description": "A past problem with its accepted answer, the actions taken and the options offered (from the knowledge graph).",
   "properties": {
    "problem_id": {
     "title": "Problem Id",
     "type": "string"
    },
    "problem": {
     "title": "Problem",
     "type": "string"
    },
    "category": {
     "title": "Category",
     "type": "string"
    },
    "similarity": {
     "title": "Similarity",
     "type": "number"
    },
    "answer": {
     "default": "",
     "title": "Answer",
     "type": "string"
    },
    "actions": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Actions",
     "type": "array"
    },
    "options": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Options",
     "type": "array"
    },
    "times_accepted": {
     "default": 0,
     "title": "Times Accepted",
     "type": "integer"
    }
   },
   "required": [
    "problem_id",
    "problem",
    "category",
    "similarity"
   ],
   "title": "KGCase",
   "type": "object"
  },
  "Objective": {
   "additionalProperties": false,
   "description": "What a good answer must achieve \u2014 the yardstick the evaluator checks the worker's result against.",
   "properties": {
    "kind": {
     "enum": [
      "explain_closure",
      "closure_impact",
      "station_profile",
      "event_effect",
      "load_ranking",
      "anomaly_cause",
      "energy_efficiency",
      "resilience_ranking",
      "demand_coupling",
      "reroute_evidence",
      "follow_up",
      "decline",
      "bounce"
     ],
     "title": "Kind",
     "type": "string"
    },
    "statement": {
     "title": "Statement",
     "type": "string"
    },
    "success_criteria": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Success Criteria",
     "type": "array"
    }
   },
   "required": [
    "kind",
    "statement"
   ],
   "title": "Objective",
   "type": "object"
  },
  "Reference": {
   "additionalProperties": false,
   "properties": {
    "kind": {
     "enum": [
      "dataset",
      "tool",
      "kb",
      "kg",
      "model"
     ],
     "title": "Kind",
     "type": "string"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "note": {
     "default": "",
     "title": "Note",
     "type": "string"
    }
   },
   "required": [
    "kind",
    "id"
   ],
   "title": "Reference",
   "type": "object"
  },
  "ToolCall": {
   "additionalProperties": false,
   "properties": {
    "tool": {
     "title": "Tool",
     "type": "string"
    },
    "server": {
     "default": "ubahn-flow-data",
     "title": "Server",
     "type": "string"
    },
    "seconds": {
     "default": 0.0,
     "title": "Seconds",
     "type": "number"
    }
   },
   "required": [
    "tool"
   ],
   "title": "ToolCall",
   "type": "object"
  },
  "WorkerResult": {
   "additionalProperties": false,
   "description": "The worker's output: the compact facts, how confident it is and why, and what it touched.",
   "properties": {
    "schema_version": {
     "default": "1.0",
     "title": "Schema Version",
     "type": "string"
    },
    "task_id": {
     "title": "Task Id",
     "type": "string"
    },
    "iteration": {
     "title": "Iteration",
     "type": "integer"
    },
    "status": {
     "enum": [
      "ok",
      "need",
      "unsupported",
      "oos",
      "follow",
      "multi",
      "error"
     ],
     "title": "Status",
     "type": "string"
    },
    "facts": {
     "additionalProperties": true,
     "title": "Facts",
     "type": "object"
    },
    "confidence": {
     "maximum": 1.0,
     "minimum": 0.0,
     "title": "Confidence",
     "type": "number"
    },
    "confidence_reasons": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Confidence Reasons",
     "type": "array"
    },
    "assumptions": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Assumptions",
     "type": "array"
    },
    "datasets_used": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Datasets Used",
     "type": "array"
    },
    "tools_called": {
     "default": [],
     "items": {
      "$ref": "#/$defs/ToolCall"
     },
     "title": "Tools Called",
     "type": "array"
    },
    "ml_engine_used": {
     "default": "none",
     "enum": [
      "tabpfn",
      "empirical",
      "none"
     ],
     "title": "Ml Engine Used",
     "type": "string"
    },
    "seconds": {
     "default": 0.0,
     "title": "Seconds",
     "type": "number"
    }
   },
   "required": [
    "task_id",
    "iteration",
    "status",
    "facts",
    "confidence"
   ],
   "title": "WorkerResult",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "Insights and results for the writer: verdict first, then evidence and references; an argument only if the operator asks why.",
 "properties": {
  "schema_version": {
   "default": "1.0",
   "title": "Schema Version",
   "type": "string"
  },
  "question": {
   "title": "Question",
   "type": "string"
  },
  "objective": {
   "$ref": "#/$defs/Objective"
  },
  "verdict": {
   "$ref": "#/$defs/EvaluatorVerdict"
  },
  "result": {
   "$ref": "#/$defs/WorkerResult"
  },
  "references": {
   "default": [],
   "items": {
    "$ref": "#/$defs/Reference"
   },
   "title": "References",
   "type": "array"
  },
  "wants_argument": {
   "default": false,
   "title": "Wants Argument",
   "type": "boolean"
  }
 },
 "required": [
  "question",
  "objective",
  "verdict",
  "result"
 ],
 "title": "WriterInput",
 "type": "object"
}