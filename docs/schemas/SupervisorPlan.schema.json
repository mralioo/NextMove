    },
    "session_id": {
     "title": "Session Id",
     "type": "string"
    },
    "similarity": {
     "title": "Similarity",
     "type": "number"
    },
    "question": {
     "title": "Question",
     "type": "string"
    },
    "answer": {
     "title": "Answer",
     "type": "string"
    },
    "category": {
     "title": "Category",
     "type": "string"
    },
    "confidence": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Confidence"
    },
    "age_s": {
     "title": "Age S",
     "type": "number"
    },
    "data_window_end": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
