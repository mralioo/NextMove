   "title": "Entities",
   "type": "object"
  },
  "FollowUp": {
   "additionalProperties": false,
   "description": "The question continues an earlier one. `mode`: explain = answer from the earlier facts; rerun = same specialist with inherited\nparameters and the operator's changes applied ('start from that point').",
   "properties": {
    "mode": {
     "enum": [
      "explain",
      "rerun"
     ],
     "title": "Mode",
     "type": "string"
    },
    "parent_category": {
     "title": "Parent Category",
     "type": "string"
    },
    "inherited": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Inherited",
     "type": "array"
    },
    "overridden": {
     "additionalProperties": true,
     "default": {},
     "title": "Overridden",
     "type": "object"
    }
   },
   "required": [
    "mode",
    "parent_category"
   ],
   "title": "FollowUp",
   "type": "object"
  },
  "GuardrailResult": {
   "additionalProperties": false,
   "description": "One guardrail check. `action` is what the system did about a failure: allow | bounce (unrelated question, conversation cut) |\ncut (stop the loop) | repair (fix the output deterministically) | fallback (safe deterministic answer) | escalate (flag low confidence).",
   "properties": {
    "stage": {
     "enum": [
      "input",
      "route",
      "worker",
      "evaluator",
      "output",
      "failsafe"
     ],
     "title": "Stage",
     "type": "string"
    },
    "check": {
     "title": "Check",
     "type": "string"
    },
    "passed": {
     "title": "Passed",
     "type": "boolean"
    },
    "action": {
     "default": "allow",
     "enum": [
      "allow",
      "bounce",
      "cut",
      "repair",
      "fallback",
      "escalate"
     ],
     "title": "Action",
     "type": "string"
    },
    "detail": {
     "default": "",
     "title": "Detail",
     "type": "string"
    }
   },
   "required": [
    "stage",
    "check",
    "passed"
   ],
   "title": "GuardrailResult",
   "type": "object"
  },
  "HistoryHit": {
   "additionalProperties": false,
   "description": "A previous, ACCEPTED answer (local turn store, mirrored to Cognee sessions) that already answers this question.",
   "properties": {
