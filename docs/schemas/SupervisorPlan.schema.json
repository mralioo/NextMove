     "title": "Category",
     "type": "string"
    },
    "confidence": {
     "title": "Confidence",
     "type": "number"
    },
    "entities": {
     "$ref": "#/$defs/Entities"
    },
    "route": {
     "$ref": "#/$defs/Route"
    }
   },
   "required": [
    "text",
    "category",
    "confidence",
    "entities",
    "route"
   ],
   "title": "PartPlan",
   "type": "object"
  },
