    }
   },
   "required": [
    "kind",
    "turn_id",
    "session_id",
    "similarity",
    "question",
    "answer",
    "category",
    "age_s"
   ],
   "title": "HistoryHit",
   "type": "object"
  },
  "Objective": {
   "additionalProperties": false,
   "description": "What a good answer must achieve \u2014 the yardstick the evaluator checks the worker's result against.",
   "properties": {
    "kind": {
     "enum": [
      "explain_closure",
      "closure_impact",
      "station_profile",
      "event_effect",
      "load_ranking",
      "anomaly_cause",
      "energy_efficiency",
      "resilience_ranking",
      "demand_coupling",
      "reroute_evidence",
      "follow_up",
      "decline",
      "bounce"
     ],
     "title": "Kind",
     "type": "string"
    },
    "statement": {
     "title": "Statement",
     "type": "string"
    },
    "success_criteria": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Success Criteria",
     "type": "array"
    }
   },
   "required": [
    "kind",
    "statement"
   ],
   "title": "Objective",
   "type": "object"
  },
  "PartPlan": {
   "additionalProperties": false,
   "description": "One question inside a multi-question message.",
   "properties": {
    "text": {
     "title": "Text",
     "type": "string"
    },
    "category": {
     "enum": [
      "A",
      "B",
      "C",
      "D",
      "E",
      "F",
      "G",
      "H",
      "P",
      "X",
      "OOS",
      "FOLLOW",
      "BOUNCE"
